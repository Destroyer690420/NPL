# ---------------------------------------------------------------------------
# Client configuration (Vite). Copy to `.env.local` and fill in your own values.
# Never commit real secrets. These keys are public Firebase *web* config values.
# ---------------------------------------------------------------------------

# Firebase web app configuration (Firebase Console -> Project settings -> Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase Emulator Suite (auth/firestore/functions)
VITE_USE_FIREBASE_EMULATORS=false

# Optional: Firebase App Check (reCAPTCHA v3 site key). Leave empty to disable.
VITE_APP_CHECK_SITE_KEY=
# Optional: App Check debug token for local development
VITE_APP_CHECK_DEBUG_TOKEN=

# Optional: override the event id used by the app. Defaults to the public
# `config/app.defaultEventId` document written by the admin panel.
VITE_DEFAULT_EVENT_ID=

# ---------------------------------------------------------------------------
# Cloud Functions configuration lives in `functions/.env` — copy
# `functions/.env.example` and see the README. The PIN secret is set with:
#   npx firebase functions:secrets:set PIN_HMAC_SECRET
# ---------------------------------------------------------------------------

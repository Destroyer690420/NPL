# ---------------------------------------------------------------------------
# Client configuration (Vite). Copy to `.env.local` and fill in your own values.
# These are public identifiers (Project URL + publishable/anon key), not secrets.
# Never put the service_role key or the database password in this file.
# ---------------------------------------------------------------------------

# Supabase project (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=
# New-style publishable key (sb_publishable_...) or legacy anon key both work.
VITE_SUPABASE_ANON_KEY=

# Optional: name of the edge function that carries the auction API.
VITE_AUCTION_FUNCTION_NAME=auction-api

# Optional: override the event id used by the app. Defaults to the public
# `app_config.defaultEventId` written by the admin panel.
VITE_DEFAULT_EVENT_ID=

# ---------------------------------------------------------------------------
# Server configuration lives in Supabase:
#   - SQL migrations: supabase/migrations/*.sql (SQL Editor, run in order)
#   - Edge Function secrets (Dashboard -> Edge Functions -> auction-api -> Secrets):
#       ADMIN_LOGIN_ID        (default: admin)
#       ADMIN_LOGIN_PASSWORD  (default: admin — change before the real event)
#       PIN_HMAC_SECRET       (optional; auto-generated and stored in the DB
#                              when unset, which is fine for a single project)
# ---------------------------------------------------------------------------

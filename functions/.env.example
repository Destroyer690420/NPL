# ---------------------------------------------------------------------------
# Runtime configuration for the Cloud Functions.
# Copy to functions/.env (git-ignored) for local development and deploys.
#
# PIN_HMAC_SECRET is a Firebase Functions *secret*, not an env entry:
#   npx firebase functions:secrets:set PIN_HMAC_SECRET
# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Interim admin login (shared credentials, verified server-side).
# CHANGE THE PASSWORD before any real event — the defaults are admin/admin and
# anyone who knows them becomes an admin. No email sign-in provider is needed.
# ---------------------------------------------------------------------------
ADMIN_LOGIN_ID=admin
ADMIN_LOGIN_PASSWORD=admin
# ADMIN_LOGIN_PASSWORD=change-me-to-something-long

# Attempt limiting for the admin login (per IP, fixed window).
MAX_ADMIN_LOGIN_ATTEMPTS_PER_WINDOW=10

# Verify App Check tokens on callables (requires VITE_APP_CHECK_SITE_KEY in the web app).
ENFORCE_APP_CHECK=false

# Must match VITE_FUNCTIONS_REGION in .env.local.
FUNCTIONS_REGION=us-central1

# How long a team PIN session stays valid before the PIN must be re-entered.
TEAM_SESSION_TTL_HOURS=12

# PIN attempt limiting (per IP and per PIN value, fixed window).
MAX_PIN_ATTEMPTS_PER_WINDOW=10
PIN_ATTEMPT_WINDOW_MINUTES=10
# Global ceiling to blunt distributed guessing across all IPs.
MAX_PIN_ATTEMPTS_GLOBAL=400

# Comma-separated browser origins allowed to call the functions.
# Leave empty to allow any origin (fine for development; set it for production).
ALLOWED_ORIGINS=
